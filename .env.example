NODE_ENV=development
PORT=3001
WEB_ORIGIN=http://127.0.0.1:3000
DATABASE_URL=postgresql://personal_ai:personal_ai@localhost:5432/personal_ai?schema=public
REDIS_URL=redis://localhost:6379

# Required. At least 32 characters. Generate a unique value locally. Do not commit it.
JWT_SECRET=
JWT_ISSUER=personal-ai-api
JWT_AUDIENCE=personal-ai
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000
# Seconds to wait before another OTP can be requested. Default 60.
# Development (NODE_ENV=development) accepts the code 123456 and does not send email.
# Production and test never accept that fixed code.
OTP_RESEND_SECONDS=60

# Server only. Never put this in a web or mobile bundle.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Unused until a later milestone. Leave blank.
TOKEN_ENCRYPTION_KEY=
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3001/api/v1/email/google/callback
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_OAUTH_REDIRECT_URI=http://localhost:3001/api/v1/email/microsoft/callback
